rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidPantryItem(data) {
      return data.keys().hasAll(['name', 'stock', 'unit', 'minStock', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.stock is number
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
        && data.minStock is number
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidMovement(data) {
      return data.keys().hasAll(['itemId', 'type', 'quantity', 'timestamp', 'previousStock', 'newStock'])
        && data.itemId is string && data.itemId.size() <= 128
        && data.type in ['ingreso', 'retiro']
        && data.quantity is number
        && data.timestamp == request.time;
    }

    function isValidShoppingItem(data) {
      return data.keys().hasAll(['name', 'requiredQuantity', 'isChecked', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.requiredQuantity is number
        && data.isChecked is bool
        && data.createdAt == request.time;
    }

    // Collection matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      match /items/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidPantryItem(incoming());
        allow update: if isOwner(userId) && (
          // Action: Update stock and metadata
          (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt', 'name', 'unit', 'minStock', 'expirationDate', 'imageUrl', 'batches'])
           && incoming().updatedAt == request.time)
        );
        allow delete: if isOwner(userId);
      }

      match /movements/{movementId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(movementId) && isValidMovement(incoming());
        // Movements are immutable
        allow update, delete: if false;
      }

      match /shoppingList/{shoppingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(shoppingId) && isValidShoppingItem(incoming());
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasAny(['isChecked', 'requiredQuantity'])
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
