{
  "entities": {
    "PantryItem": {
      "title": "Pantry Item",
      "description": "An item stored in the pantry or inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the food or product" },
        "stock": { "type": "number", "description": "Current quantity in stock" },
        "unit": { "type": "string", "description": "Unit of measurement (e.g., kg, unit, Litros)" },
        "minStock": { "type": "number", "description": "Minimum stock level before alert" },
        "expirationDate": { "type": "string", "format": "date", "description": "Expiration date in YYYY-MM-DD" },
        "imageUrl": { "type": "string", "description": "URL of the AI generated image" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "stock", "unit", "minStock"]
    },
    "Movement": {
      "title": "Stock Movement",
      "description": "History of stock changes",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "description": "Reference to the item" },
        "type": { "type": "string", "enum": ["ingreso", "retiro"], "description": "Type of movement" },
        "quantity": { "type": "number", "description": "Amount changed" },
        "timestamp": { "type": "string", "format": "date-time" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" }
      },
      "required": ["itemId", "type", "quantity", "timestamp"]
    },
    "ShoppingItem": {
      "title": "Shopping List Item",
      "description": "Item to be purchased",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "requiredQuantity": { "type": "number" },
        "isChecked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "requiredQuantity", "isChecked"]
    }
  },
  "firestore": {
    "/users/{userId}/items/{itemId}": {
      "schema": "PantryItem",
      "description": "User specific inventory items"
    },
    "/users/{userId}/movements/{movementId}": {
      "schema": "Movement",
      "description": "History of stock movements for the user"
    },
    "/users/{userId}/shoppingList/{shoppingId}": {
      "schema": "ShoppingItem",
      "description": "User's shopping list"
    }
  }
}
